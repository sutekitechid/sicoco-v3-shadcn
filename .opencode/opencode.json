{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "dirs": ["../.agents/skills"],
    "auto_load": true,
    "auto_discover": true
  },
  "mcp": {
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "mcp-figma"],
      "env": {
        "FIGMA_API_KEY": "${env:FIGMA_PAT}"
      },
      "enabled": true,
      "_source_config": "../mcp/figma.json"
    }
  }
}
