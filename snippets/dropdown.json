{
	"Dropdown Basic sicoco": {
		"prefix": "sidropdown",
		"body": [
			"<SDropdown",
			"  v-model=\"$1\"",
			">",
			"  <SDropdownItem",
			"    v-for=\"item in $2\"",
			"    :key=\"item.value\"",
			"    :value=\"item.value\"",
			"  >",
			"    <span>{{ item.label }}</span>",
			"  </SDropdownItem>",
			"</SDropdown>"
		],
		"description": "Basic Dropdown with DropdownItem"
	},

	"Dropdown With Custom Trigger sicoco": {
		"prefix": "sidropdown:custom-trigger",
		"body": [
			"<SDropdown>",
			"  <template #trigger=\"{ open }\">",
			"    <SButton>$1</SButton>",
			"  </template>",
			"  <SDropdownItem",
			"    v-for=\"item in $2\"",
			"    :key=\"item.value\"",
			"    :value=\"item.value\"",
			"  >",
			"    <span>{{ item.label }}</span>",
			"  </SDropdownItem>",
			"</SDropdown>"
		],
		"description": "Dropdown with custom trigger"
	},

