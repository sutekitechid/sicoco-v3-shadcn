{
	"SAlert Sicoco": {
		"prefix": "sialert",
		"body": [
			"<SAlert bordered closable has-icon outlined>",
			"  <SAlertDescription>",
			"    $0",
			"  </SAlertDescription>",
			"</SAlert>"
		],
		"description": "Sicoco Alert component (default success variant)"
	},
