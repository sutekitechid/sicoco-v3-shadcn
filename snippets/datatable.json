{
	"DataTable Sicoco": {
		"prefix": "sidatatable",
		"body": [
			"<DataTable",
			"id=\"example-datatable\"",
			"\t:data=\"data\"",
			"\tdata-cy=\"example-datatable\"",
			"\tv-model=\"selectedRows\"",
			"\tv-model:page=\"page\"",
			"\tv-model:per-page=\"perPage\"",
			"\t:total=\"total\"",
			"\t:is-row-selectable=\"isRowSelectable\"",
			"\t:loading=\"loading\"",
			"\tpaginated",
			"\tselectable",
			"\t:row-class=\"getRowClass\"",
			"\t:sticky-headers=\"stickyHeaders\"",
			"\t:headers-text-wrap=\"headersTextWrap\"",
			"\t@sort=\"onSort\"",
			"\t@change-page=\"onChangePage\"",
			"\t@change-per-page=\"onChangePerPage\"",
			">",
			"\t<DataTableColumn field=\"id\" sortable :header-text-wrap=\"headersTextWrap\">",
			"\t</DataTableColumn>",
			"</DataTable>"
		],
		"description": "A Datatable component is a UI element used to display and manage tabular data, allowing users to view, sort, filter, and manipulate information in a structured format."
	},
	"Infinite Scroll DataTable Sicoco": {
		"prefix": "sidatatable:infinite",
		"body": [
			"<DataTable",
			"id=\"example-datatable\"",
			"\t:data=\"data\"",
			"\tdata-cy=\"example-datatable\"",
			"\tv-model=\"selectedRows\"",
			"\tv-model:page=\"page\"",
			"\tv-model:per-page=\"perPage\"",
			"\t:total=\"total\"",
			"\t:is-row-selectable=\"isRowSelectable\"",
			"\t:loading=\"loading\"",
			"\tinfinite-scroll",
			">",
			"\t<DataTableColumn field=\"id\" sortable :header-text-wrap=\"headersTextWrap\">",
			"\t</DataTableColumn>",
			"</DataTable>"
		],
		"description": "A Datatable component with infinite scroll used to manage pagination and loading of data dynamically as the user scrolls through the table, enhancing performance and user experience."
	},
	"Datatable grouping Sicoco": {
		"prefix": "sidatatable:grouping",
		"body": [
			"<DataTable",
      "  id=\"$1\"",
      "  :data=\"$2\"",
      "  :multiple-sort=\"${3:true}\"",
      "  :sticky-headers=\"${4:true}\"",
      "  @sort-change=\"$5\"",
      ">",
      "  <DataTableGroup name=\"$6\" :order=\"${8:1}\">",
      "    <template #header>",
      "      <span class=\"font-semibold\">${9:Group Header}</span>",
      "    </template>",
      "",
      "    <DataTableColumn field=\"$10\" group=\"$6\" :order=\"${11:1}\" :sortable=\"${12:true}\">",
      "      <template #header>",
      "        ${13:<!-- Header Content -->}",
      "      </template>",
      "      <template #default=\"{ row }\">",
      "        ${14:<!-- Row Content -->}",
      "      </template>",
      "    </DataTableColumn>",
      "",
      "    <DataTableColumn field=\"$15\" group=\"$6\" :order=\"${16:2}\">",
      "      <template #header>",
      "        ${17:<!-- Header Content -->}",
      "      </template>",
      "      <template #default=\"{ row }\">",
      "        ${18:<!-- Row Content -->}",
      "      </template>",
      "    </DataTableColumn>",
      "  </DataTableGroup>",
      "",
      "  <DataTableColumn field=\"$19\" :order=\"${21:3}\" :sortable=\"${22:true}\">",
      "    <template #header>",
      "      <span class=\"font-semibold\">${23:Column Label}</span>",
      "    </template>",
      "    <template #default=\"{ row }\">",
      "      <span>{{ row.${19} }}</span>",
      "    </template>",
      "  </DataTableColumn>",
      "</DataTable>"
		],
		"description": "DataTable with grouped columns and sortable feature."
	},
	"Import DataTable Sicoco": {
		"prefix": "sidatatable:import",
		"body": [
			"import { SDataTable, SDataTableColumn } from '@sutekitechid/sicoco-v3-next';"
		],
		"description": "Importing the DataTable and DataTableColumn components from the Sico UI library to use them in your Vue.js component."
	}
}
