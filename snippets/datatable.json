{
	"SDataTable Sicoco": {
		"prefix": "sidatatable",
		"body": [
			"<SDataTable",
			"  id=\"${1:example-datatable}\"",
			"  :data=\"${2:data}\"",
			"  :data-cy=\"${3:example-datatable}\"",
			"  :data-testid=\"${3:example-datatable}\"",
			"  v-model=\"${4:selectedRows}\"",
			"  v-model:page=\"${5:page}\"",
			"  v-model:per-page=\"${6:perPage}\"",
			"  :total=\"${7:total}\"",
			"  :is-row-selectable=\"${8:isRowSelectable}\"",
			"  :loading=\"${9:loading}\"",
			"  paginated",
			"  selectable",
			"  :row-class=\"${10:getRowClass}\"",
			"  :sticky-headers=\"${11:stickyHeaders}\"",
			"  :headers-text-wrap=\"${12:headersTextWrap}\"",
			"  @sort=\"${13:onSort}\"",
			"  @change-page=\"${14:onChangePage}\"",
			"  @change-per-page=\"${15:onChangePerPage}\"",
			">",
			"  <SDataTableColumn field=\"${16:id}\" sortable :header-text-wrap=\"${17:headersTextWrap}\" />",
			"</SDataTable>"
		],
		"description": "Sicoco DataTable component with pagination and selection"
	},
	"SDataTable Infinite Scroll Sicoco": {
		"prefix": "sidatatable:infinite",
		"body": [
			"<SDataTable",
			"  id=\"${1:example-datatable}\"",
			"  :data=\"${2:data}\"",
			"  :data-cy=\"${3:example-datatable}\"",
			"  :data-testid=\"${3:example-datatable}\"",
			"  v-model=\"${4:selectedRows}\"",
			"  v-model:page=\"${5:page}\"",
			"  v-model:per-page=\"${6:perPage}\"",
			"  :total=\"${7:total}\"",
			"  :is-row-selectable=\"${8:isRowSelectable}\"",
			"  :loading=\"${9:loading}\"",
			"  infinite-scroll",
			">",
			"  <SDataTableColumn field=\"${10:id}\" sortable :header-text-wrap=\"${11:headersTextWrap}\" />",
			"</SDataTable>"
		],
		"description": "Sicoco DataTable with infinite scroll"
	},
	"SDataTable Grouping Sicoco": {
		"prefix": "sidatatable:grouping",
		"body": [
			"<SDataTable",
			"  id=\"${1:id}\"",
			"  :data=\"${2:data}\"",
			"  :multiple-sort=\"${3:true}\"",
			"  :sticky-headers=\"${4:true}\"",
			"  @sort-change=\"${5:onSortChange}\"",
			">",
			"  <SDataTableGroupColumn name=\"${6:groupName}\" :order=\"${7:1}\">",
			"    <template #header>",
			"      <span class=\"font-semibold\">${8:Group Header}</span>",
			"    </template>",
			"    <SDataTableColumn field=\"${9:columnField}\" group=\"${6:groupName}\" :order=\"${10:1}\" :sortable=\"${11:true}\">",
			"      <template #header>",
			"        ${12:<!-- Header Content -->}",
			"      </template>",
			"      <template #default=\"{ row }\">",
			"        ${13:<!-- Row Content -->}",
			"      </template>",
			"    </SDataTableColumn>",
			"    <SDataTableColumn field=\"${14:columnField2}\" group=\"${6:groupName}\" :order=\"${15:2}\">",
			"      <template #header>",
			"        ${16:<!-- Header Content -->}",
			"      </template>",
			"      <template #default=\"{ row }\">",
			"        ${17:<!-- Row Content -->}",
			"      </template>",
			"    </SDataTableColumn>",
			"  </SDataTableGroupColumn>",
			"  <SDataTableColumn field=\"${18:columnField3}\" :order=\"${19:3}\" :sortable=\"${20:true}\">",
			"    <template #header>",
			"      <span class=\"font-semibold\">${21:Column Label}</span>",
			"    </template>",
			"    <template #default=\"{ row }\">",
			"      <span>{{ row.${18:columnField3} }}</span>",
			"    </template>",
			"  </SDataTableColumn>",
			"</SDataTable>"
		],
		"description": "Sicoco DataTable with grouped columns and sortable"
	},
	"SDataTable Import Sicoco": {
		"prefix": "sidatatable:import",
		"body": [
			"import {",
			"  SDataTable,",
			"  SDataTableColumn,",
			"  SDataTableGroupColumn,",
			"  SORT_DIRECTION,",
			"  PIN_DIRECTION",
			"} from '@sutekitechid/sicoco-v3-next';"
		],
		"description": "Import Sicoco DataTable components and enums"
	}
}
