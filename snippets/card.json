{
	"SCard Basic Sicoco": {
		"prefix": "sicard",
		"body": [
			"<SCard>",
			"  $0",
			"</SCard>"
		],
		"description": "Sicoco Card wrapper"
	},
	"SCard Full Sicoco": {
		"prefix": "sicard:full",
		"body": [
			"<SCard>",
			"  <SCardHeader>",
			"    <SCardTitle>$1</SCardTitle>",
			"    <SCardDescription>$2</SCardDescription>",
			"  </SCardHeader>",
			"  <SCardContent>",
			"    $3",
			"  </SCardContent>",
			"  <SCardFooter>",
			"    $4",
			"  </SCardFooter>",
			"</SCard>"
		],
		"description": "Sicoco Card with header, content, and footer"
	},
	"SCard Header Sicoco": {
		"prefix": "sicard:header",
		"body": [
			"<SCardHeader>",
			"  <SCardTitle>$1</SCardTitle>",
			"  <SCardDescription>$2</SCardDescription>",
			"</SCardHeader>"
		],
		"description": "Sicoco CardHeader with title and description"
	},
	"SCard Import Sicoco": {
		"prefix": "sicard:import",
		"body": [
			"import { SCard, SCardContent, SCardDescription, SCardFooter, SCardHeader, SCardTitle } from '@sutekitechid/sicoco-v3-next'"
		],
		"description": "Import Sicoco Card components"
	}
}
