{
	"SFormInput Sicoco": {
		"prefix": "siforminput",
		"body": [
			"<SFormInput",
			"  autocomplete=\"${1:on}\"",
			"  novalidate",
			"  @submit=\"${2}\"",
			">",
			"${3}",
			"</SFormInput>"
		],
		"description": "Sicoco FormInput wrapper for validation of child inputs"
	},
	"SFormInput Import Sicoco": {
		"prefix": "siforminput:import",
		"body": ["import { SFormInput } from '@sutekitechid/sicoco-v3-next';"],
		"description": "Import Sicoco FormInput component"
	}
}
