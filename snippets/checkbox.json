{
	"SCheckbox Sicoco": {
		"prefix": "sicheckbox",
		"body": [
			"<SCheckbox",
			"  v-model=\"$1\"",
			"  :value=\"$2\"",
			"  size=\"${3:sm | md | lg | xl | 2xl | 3xl | 4xl}\"",
			"  :checked=\"${4:false}\"",
			"  :checked-icon=\"${5:'si-check'}\"",
			"  :rounded=\"${6:false}\"",
			"  :disabled=\"${7:false}\"",
			">",
			"  $0",
			"</SCheckbox>"
		],
		"description": "Sicoco Checkbox with v-model, size, and state props"
	},
