{
	"SCalendar Basic Sicoco": {
		"prefix": "sicalendar",
		"body": ["<SCalendar v-model=\"$1\" />"],
		"description": "Sicoco Calendar component"
	},
	"SCalendar Show Outside View Dates Sicoco": {
		"prefix": "sicalendar:show-outside-view-dates",
		"body": [
			"<SCalendar v-model=\"$1\" :show-outside-view-dates=\"false\" />"
		],
		"description": "Sicoco Calendar that hides outside view dates"
	},
	"SCalendar With Years Range Sicoco": {
		"prefix": "sicalendar:years-range",
		"body": ["<SCalendar v-model=\"$1\" :years-range=\"$2\" />"],
		"description": "Sicoco Calendar with years range"
	},
	"SCalendar With Important Dates Sicoco": {
		"prefix": "sicalendar:important-dates",
		"body": ["<SCalendar v-model=\"$1\" :important-dates=\"$2\" />"],
		"description": "Sicoco Calendar with important dates"
	},
	"SCalendar Readonly Sicoco": {
		"prefix": "sicalendar:readonly",
		"body": ["<SCalendar v-model=\"$1\" readonly />"],
		"description": "Sicoco Calendar in readonly mode"
	},
	"SCalendar Locale Sicoco": {
		"prefix": "sicalendar:locale",
		"body": ["<SCalendar v-model=\"$1\" :locale=\"$2\" />"],
		"description": "Sicoco Calendar with custom locale"
	},
	"SCalendar With Emits Sicoco": {
		"prefix": "sicalendar:emits",
		"body": [
			"<SCalendar",
			"  v-model=\"$1\"",
			"  @month-change=\"$2\"",
			"  @year-change=\"$3\"",
			"/>"
		],
		"description": "Sicoco Calendar with month-change and year-change emits"
	},
	"SCalendar With Header Slot Sicoco": {
		"prefix": "sicalendar:slot-header",
		"body": [
			"<SCalendar v-model=\"$1\">",
			"  <template #header>",
			"    <div class=\"mb-2 flex w-full items-center justify-between\">",
			"      <SButton rounded outlined class=\"w-7 h-7 p-1\" @click=\"$2\">",
			"        <i class=\"si-chevron-left\"></i>",
			"      </SButton>",
			"      <p class=\"font-semibold\">{{ $3 }}</p>",
			"      <SButton rounded outlined class=\"w-7 h-7 p-1\" @click=\"$4\">",
			"        <i class=\"si-chevron-right\"></i>",
			"      </SButton>",
			"    </div>",
			"  </template>",
			"</SCalendar>"
		],
		"description": "Sicoco Calendar with custom header slot"
	},
	"SCalendar Import Sicoco": {
		"prefix": "sicalendar:import",
		"body": ["import { SCalendar } from '@sutekitechid/sicoco-v3-next'"],
		"description": "Import Sicoco Calendar component"
	}
}
