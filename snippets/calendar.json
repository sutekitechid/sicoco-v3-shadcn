{
	"SICalendar Basic Sicoco": {
		"prefix": "sicalendar",
		"body": ["<SCalendar", "  v-model=\"$1\"", "/>"],
		"description": "Basic Calendar component"
	},
	"SICalendar Show View Outside Dates Sicoco": {
		"prefix": "sicalendar:show-outside-view-dates",
		"body": [
			"<SCalendar",
			"  v-model=\"$1\"",
			"  :show-outside-view-dates=\"false\"",
			"/>"
		],
		"description": "Calendar showing view outside dates"
	},
	"SICalendar With Years Range Sicoco": {
		"prefix": "sicalendar:years-range",
		"body": ["<SCalendar", "  v-model=\"$1\"", "  :years-range=\"$2\"", "/>"],
		"description": "Calendar with years range"
	},
	"SICalendar With Important Dates Sicoco": {
		"prefix": "sicalendar:important-dates",
		"body": [
			"<SCalendar",
			"  v-model=\"$1\"",
			"  :important-dates=\"$2\"",
			"/>"
		],
		"description": "Calendar with importantDates"
	},
	"SICalendar Readonly Sicoco": {
		"prefix": "sicalendar:readonly",
		"body": ["<SCalendar", "  v-model=\"$1\"", "  readonly", "/>"],
		"description": "Readonly Calendar"
	},
	"SICalendar Locale Sicoco": {
		"prefix": "sicalendar:locale",
		"body": ["<SCalendar", "  v-model=\"$1\"", "  :locale=\"$2\"", "/>"],
		"description": "Calendar with custom locale"
	},
	"SICalendar With Emits Sicoco": {
		"prefix": "sicalendar:handle-change-month-and-year",
		"body": [
			"<SCalendar",
			"  v-model=\"$1\"",
			"  @month-change=\"$2\"",
			"  @year-change=\"$3\"",
			"/>"
		],
		"description": "Calendar with month-change and year-change emits"
	},
	"SICalendar With Header Slot Sicoco": {
		"prefix": "sicalendar:slot-header",
		"body": [
			"<SCalendar v-model=\"$1\">",
			"  <template #header>",
			"    <div class=\"mb-2 flex w-full items-center justify-between\">",
			"      <SButton",
			"        rounded",
			"        outlined",
			"        @click=\"$2\"",
			"        class=\"w-7 h-7 p-1\"",
			"      >",
			"        <i class=\"si-chevron-left\"></i>",
			"      </SButton>",
			"      <p class=\"font-semibold\">",
			"        {{ $3 }}",
			"      </p>",
			"      <SButton",
			"        rounded",
			"        outlined",
			"        @click=\"$4\"",
			"        class=\"w-7 h-7 p-1\"",
			"      >",
			"        <i class=\"si-chevron-right\"></i>",
			"      </SButton>",
			"    </div>",
			"  </template>",
			"</SCalendar>"
		],
		"description": "Calendar with custom header slot"
	},
	"SCalendar Import Sicoco": {
		"prefix": "sicalendar:import",
		"body": ["import { SCalendar } from '@sutekitechid/sicoco-v3-next'"],
		"description": "Import the SCalendar component from the Sicoco library."
	}
}
