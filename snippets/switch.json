{
	"Switch Basic": {
		"prefix": "sswitch",
		"body": ["<SSWitch v-model=\"$1\" />"],
		"description": "Basic Switch component"
	},
	"Switch Disabled": {
		"prefix": "sswitch:disabled",
		"body": ["<SSWitch v-model=\"$1\" disabled />"],
		"description": "Disabled Switch"
	},
	"Switch With Label": {
		"prefix": "sswitch:label",
		"body": [
			"<label class=\"flex items-center gap-2\">",
			"  <SSWitch v-model=\"$1\" />",
			"  <span>$2</span>",
			"</label>"
		],
		"description": "Switch with label"
	},
	"Switch Custom Value": {
		"prefix": "sswitch:custom",
		"body": [
			"<SSWitch",
			"  v-model=\"$1\"",
			"  :true-value=\"'yes'\"",
			"  :false-value=\"'no'\"",
			"/>"
		],
		"description": "Switch with custom true/false values"
	},
	"Switch Default": {
		"prefix": "sswitch:default",
		"body": ["<SSWitch v-model=\"$1\" variant=\"default\" />"],
		"description": "Switch with default variant"
	},
	"Switch Primary": {
		"prefix": "sswitch:primary",
		"body": ["<SSWitch v-model=\"$1\" variant=\"primary\" />"],
		"description": "Switch with primary variant"
	},
	"Switch Success": {
		"prefix": "sswitch:success",
		"body": ["<SSWitch v-model=\"$1\" variant=\"success\" />"],
		"description": "Switch with success variant"
	},
	"Switch Warning": {
		"prefix": "sswitch:warning",
		"body": ["<SSWitch v-model=\"$1\" variant=\"warning\" />"],
		"description": "Switch with warning variant"
	},
	"Switch Danger": {
		"prefix": "sswitch:danger",
		"body": ["<SSWitch v-model=\"$1\" variant=\"danger\" />"],
		"description": "Switch with danger variant"
	},
	"Switch Secondary": {
		"prefix": "sswitch:secondary",
		"body": ["<SSWitch v-model=\"$1\" variant=\"secondary\" />"],
		"description": "Switch with secondary variant"
	},
	"Switch Purple": {
		"prefix": "sswitch:purple",
		"body": ["<SSWitch v-model=\"$1\" variant=\"purple\" />"],
		"description": "Switch with purple variant"
	},
	"Switch Grey": {
		"prefix": "sswitch:grey",
		"body": ["<SSWitch v-model=\"$1\" variant=\"grey\" />"],
		"description": "Switch with grey variant"
	},
	"Switch Gray": {
