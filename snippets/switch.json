{
	"SSWitch Basic Sicoco": {
		"prefix": "siswitch",
		"body": ["<SSWitch v-model=\"$1\" />"],
		"description": "Sicoco Switch component"
	},
	"SSWitch Disabled Sicoco": {
		"prefix": "siswitch:disabled",
		"body": ["<SSWitch v-model=\"$1\" disabled />"],
		"description": "Sicoco Switch in disabled state"
	},
	"SSWitch With Label Sicoco": {
		"prefix": "siswitch:label",
		"body": [
			"<label class=\"flex items-center gap-2\">",
			"  <SSWitch v-model=\"$1\" />",
			"  <span>$2</span>",
			"</label>"
		],
		"description": "Sicoco Switch with label"
	},
	"SSWitch Custom Value Sicoco": {
		"prefix": "siswitch:custom",
		"body": [
			"<SSWitch v-model=\"$1\" :true-value=\"'yes'\" :false-value=\"'no'\" />"
		],
		"description": "Sicoco Switch with custom true/false values"
	},
	"SSWitch Default Variant Sicoco": {
		"prefix": "siswitch:default",
		"body": ["<SSWitch v-model=\"$1\" variant=\"default\" />"],
		"description": "Sicoco Switch with default variant"
	},
