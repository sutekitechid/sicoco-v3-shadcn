{
	"Switch Basic Sicoco": {
		"prefix": "siswitch",
		"body": ["<SSWitch v-model=\"$1\" />"],
		"description": "Basic Switch component"
	},
	"Switch Disabled Sicoco": {
		"prefix": "siswitch:disabled",
		"body": ["<SSWitch v-model=\"$1\" disabled />"],
		"description": "Disabled Switch"
	},
	"Switch With Label Sicoco": {
		"prefix": "siswitch:label",
		"body": [
			"<label class=\"flex items-center gap-2\">",
			"  <SSWitch v-model=\"$1\" />",
			"  <span>$2</span>",
			"</label>"
		],
		"description": "Switch with label"
	},
	"Switch Custom Value Sicoco": {
		"prefix": "siswitch:custom",
		"body": [
			"<SSWitch",
			"  v-model=\"$1\"",
			"  :true-value=\"'yes'\"",
			"  :false-value=\"'no'\"",
			"/>"
		],
		"description": "Switch with custom true/false values"
	},
	"Switch Default Sicoco": {
		"prefix": "siswitch:default",
		"body": ["<SSWitch v-model=\"$1\" variant=\"default\" />"],
		"description": "Switch with default variant"
	},
