{
	"SAccordion Sicoco": {
		"prefix": "siaccordion",
		"body": [
			"<SAccordion v-model=\"$1\" collapsible destroy-on-hide>",
			"  <SAccordionItem :value=\"$2\" :key=\"$3\">",
			"    <SAccordionTrigger>",
			"      <template #label>$4</template>",
			"    </SAccordionTrigger>",
			"    <SAccordionContent>",
			"      $5",
			"    </SAccordionContent>",
			"  </SAccordionItem>",
			"</SAccordion>"
		],
		"description": "Sicoco Accordion component with single open item"
	},
	"SAccordion Multiple Sicoco": {
		"prefix": "siaccordion:multiple",
		"body": [
			"<SAccordion v-model=\"$1\" type=\"multiple\" collapsible destroy-on-hide>",
			"  <SAccordionItem :value=\"$2\" :key=\"$3\">",
			"    <SAccordionTrigger>",
			"      <template #label>$4</template>",
			"    </SAccordionTrigger>",
			"    <SAccordionContent>",
			"      $5",
			"    </SAccordionContent>",
			"  </SAccordionItem>",
			"</SAccordion>"
		],
		"description": "Sicoco Accordion with multiple open items"
	},
	"SAccordion Import Sicoco": {
		"prefix": "siaccordion:import",
		"body": [
			"import {",
			"  SAccordion,",
			"  SAccordionItem,",
			"  SAccordionTrigger,",
			"  SAccordionContent",
			"} from '@sutekitechid/sicoco-v3-next'"
		],
		"description": "Import Sicoco Accordion components"
	}
}
