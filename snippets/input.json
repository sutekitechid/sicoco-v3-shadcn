	},
	"SInput Max Fractional Digits Sicoco": {
		"prefix": "siinput:maxfractiondigits",
		"body": [
			"<SInput v-model=\"$1\"",
			"   type=\"${2:number}\"",
			"   name=\"${3:number}\"",
			"   :max-fraction-digits=\"${4:2}\"",
			"   decimal",
			"/>"
		],
		"description": "Input component from Sicoco with maximum fractional digits validation"
	},
	"SInput Import Sicoco": {
		"prefix": "siinput:import",
		"body": ["import SInput from '@/components/input/Input.vue'"],
		"description": "Import SInput component from Sicoco"
	}
