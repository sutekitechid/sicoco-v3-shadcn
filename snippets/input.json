{
	"SInput Sicoco": {
		"prefix": "siinput",
		"body": [
			"<SInput v-model=\"$1\"",
			"   type=\"${2:text}\"",
			"   name=\"${3:text}\"",
			"   placeholder=\"${4:Enter text}\"",
			"/>"
		],
		"description": "Input component from Sicoco"
	},
	"SInput Small Sicoco": {
