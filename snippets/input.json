{
	"SInput Basic Sicoco": {
		"prefix": "siinput",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter text}\" />"
		],
		"description": "Sicoco Input component"
	},
	"SInput Small Sicoco": {
		"prefix": "siinput:sm",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter text}\" size=\"sm\" />"
		],
		"description": "Sicoco Input with small size"
	},
	"SInput Medium Sicoco": {
		"prefix": "siinput:md",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter text}\" size=\"md\" />"
		],
		"description": "Sicoco Input with medium size"
	},
	"SInput Large Sicoco": {
		"prefix": "siinput:lg",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter text}\" size=\"lg\" />"
		],
		"description": "Sicoco Input with large size"
	},
	"SInput Disabled Sicoco": {
		"prefix": "siinput:disabled",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter text}\" disabled />"
		],
		"description": "Sicoco Input in disabled state"
	},
	"SInput Readonly Sicoco": {
		"prefix": "siinput:readonly",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter text}\" readonly />"
		],
		"description": "Sicoco Input in readonly state"
	},
	"SInput Required Sicoco": {
		"prefix": "siinput:required",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter text}\" required>",
			"  <template #required>Cannot be empty</template>",
			"</SInput>"
		],
		"description": "Sicoco Input with required validation"
	},
	"SInput Number Min Max Sicoco": {
		"prefix": "siinput:number-minmax",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:number}\" name=\"${3:number}\" :min=\"${4:0}\" :max=\"${5:10}\">",
			"  <template #minValue>Cannot be less than 0</template>",
			"  <template #maxValue>Cannot be more than 10</template>",
			"</SInput>"
		],
		"description": "Sicoco number Input with min and max validation"
	},
	"SInput Minlength Sicoco": {
		"prefix": "siinput:minlength",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter your name}\" :min-length=\"${5:2}\">",
			"  <template #minLength>Cannot be less than 2 characters</template>",
			"</SInput>"
		],
		"description": "Sicoco Input with min-length validation"
	},
	"SInput Maxlength Sicoco": {
		"prefix": "siinput:maxlength",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter your name}\" :max-length=\"${5:50}\">",
			"  <template #maxLength>Cannot be more than 50 characters</template>",
			"</SInput>"
		],
		"description": "Sicoco Input with max-length validation"
	},
	"SInput Exact Length Sicoco": {
		"prefix": "siinput:exactlength",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter your account ID}\" :exact-length=\"${5:5}\">",
			"  <template #exactLength>Must be exactly 5 characters</template>",
			"</SInput>"
		],
		"description": "Sicoco Input with exact-length validation"
	},
	"SInput URL Sicoco": {
		"prefix": "siinput:url",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:url}\" name=\"${3:url}\" placeholder=\"${4:Example: https://www.google.com}\">",
			"  <template #url>Must be a valid URL</template>",
			"</SInput>"
		],
		"description": "Sicoco Input with URL validation"
	},
	"SInput Email Sicoco": {
		"prefix": "siinput:email",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:email}\" name=\"${3:email}\" placeholder=\"${4:Example: sicoco@email.com}\">",
			"  <template #email>Must be a valid email</template>",
			"</SInput>"
		],
		"description": "Sicoco Input with email validation"
	},
	"SInput Prefix Sicoco": {
		"prefix": "siinput:prefix",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter username}\">",
			"  <template #prefix>",
			"    <i class=\"${5:si-user}\" />",
			"  </template>",
			"</SInput>"
		],
		"description": "Sicoco Input with prefix slot"
	},
	"SInput Suffix Sicoco": {
		"prefix": "siinput:suffix",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:text}\" name=\"${3:text}\" placeholder=\"${4:Enter username}\">",
			"  <template #suffix>",
			"    <i class=\"${5:si-user}\" />",
			"  </template>",
			"</SInput>"
		],
		"description": "Sicoco Input with suffix slot"
	},
	"SInput Password Sicoco": {
		"prefix": "siinput:password",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:password}\" name=\"${3:password}\" placeholder=\"${4:Enter password}\" />"
		],
		"description": "Sicoco Input of type password"
	},
	"SInput Currency Sicoco": {
		"prefix": "siinput:currency",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:currency}\" name=\"${3:amount}\" placeholder=\"${4:Enter amount}\" />"
		],
		"description": "Sicoco Input of type currency"
	},
	"SInput Decimal Sicoco": {
		"prefix": "siinput:decimal",
		"body": [
			"<SInput v-model=\"$1\" type=\"${2:number}\" name=\"${3:number}\" :max-fraction-digits=\"${4:2}\" decimal />"
		],
		"description": "Sicoco number Input with decimal and max-fraction-digits"
	},
	"SInput Import Sicoco": {
		"prefix": "siinput:import",
		"body": ["import { SInput } from '@sutekitechid/sicoco-v3-next'"],
		"description": "Import Sicoco Input component"
	}
}
