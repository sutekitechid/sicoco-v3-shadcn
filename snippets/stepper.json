{
	"SStepper Sicoco": {
		"prefix": "sistepper",
		"body": [
			"<SStepper v-model=\"${1:currentStep}\">",
			"  <SStepperItem",
			"    v-for=\"(${2:item}, ${3:index}) in ${4:steps}\"",
			"    :key=\"${5:item.step}\"",
			"    :step=\"${6:item.step}\"",
			"    :steps-count=\"${7:steps.length}\"",
			"  >",
			"    <template #trigger>",
			"      <SStepperTrigger>",
			"        <SStepperIndicator>${8:indicator}</SStepperIndicator>",
			"      </SStepperTrigger>",
			"    </template>",
			"    <template #label>",
			"      <SStepperTitle>${9:title}</SStepperTitle>",
			"      <SStepperDescription>${10:description}</SStepperDescription>",
			"    </template>",
			"  </SStepperItem>",
			"  <SStepperSeparator />",
			"</SStepper>"
		],
		"description": "Sicoco Stepper component with dynamic steps"
	},
	"SStepper Import Sicoco": {
		"prefix": "sistepper:import",
		"body": [
			"import {",
			"  SStepper,",
			"  SStepperDescription,",
			"  SStepperIndicator,",
			"  SStepperItem,",
			"  SStepperTitle,",
			"  SStepperTrigger,",
			"  SStepperSeparator",
			"} from '@sutekitechid/sicoco-v3-next'"
		],
		"description": "Import Sicoco Stepper components"
	}
}
