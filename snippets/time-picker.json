{
	"TimePicker Basic Sicoco": {
		"prefix": "sitimepicker",
		"body": ["<STimePicker", "  v-model=\"$1\"", "/>"],
		"description": "Basic STimePicker component"
	},
	"TimePicker Required Sicoco": {
		"prefix": "sitimepicker:required",
		"body": [
			"<STimePicker",
			"  v-model=\"$1\"",
			"  required",
			">",
			"  <template #required>",
			"    <span>isi dong</span>",
			"  </template>",
			"</STimePicker>"
		],
		"description": "STimePicker with required prop"
	},
	"TimePicker Disabled Sicoco": {
		"prefix": "sitimepicker:disabled",
		"body": ["<STimePicker", "  v-model=\"$1\"", "  disabled", "/>"],
		"description": "STimePicker with disabled prop"
	},
	"TimePicker Custom Validators Sicoco": {
		"prefix": "sitimepicker:custom-validators",
		"body": [
			"<STimePicker",
			"  v-model=\"$1\"",
			"  :custom-validators=\"{ customRule: value => value !== null }\"",
			">",
			"  <template #errors=\"{ validation }\">",
			"    <p v-if=\"validation.customRule.$invalid\">Custom validation error</p>",
			"  </template>",
			"</STimePicker>"
		],
		"description": "STimePicker with custom validators"
	},
	"TimePicker Import Sicoco": {
		"prefix": "sitimepicker:import",
		"body": ["import { STimePicker } from '@sutekitechid/sicoco-v3-next'"],
		"description": "Import the STimePicker component from the Sicoco library."
	}
}
