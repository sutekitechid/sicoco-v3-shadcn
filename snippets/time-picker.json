{
	"STimePicker Basic Sicoco": {
		"prefix": "sitimepicker",
		"body": ["<STimePicker v-model=\"$1\" />"],
		"description": "Sicoco TimePicker component"
	},
	"STimePicker Required Sicoco": {
		"prefix": "sitimepicker:required",
		"body": [
			"<STimePicker v-model=\"$1\" required>",
			"  <template #required>",
			"    <span>Cannot be empty</span>",
			"  </template>",
			"</STimePicker>"
		],
		"description": "Sicoco TimePicker with required validation"
	},
	"STimePicker Disabled Sicoco": {
		"prefix": "sitimepicker:disabled",
		"body": ["<STimePicker v-model=\"$1\" disabled />"],
		"description": "Sicoco TimePicker in disabled state"
	},
	"STimePicker Custom Validators Sicoco": {
		"prefix": "sitimepicker:custom-validators",
		"body": [
			"<STimePicker",
			"  v-model=\"$1\"",
			"  :custom-validators=\"{ customRule: value => value !== null }\"",
			">",
			"  <template #errors=\"{ validation }\">",
			"    <p v-if=\"validation.customRule.$invalid\">$2</p>",
			"  </template>",
			"</STimePicker>"
		],
		"description": "Sicoco TimePicker with custom validators"
	},
	"STimePicker Import Sicoco": {
		"prefix": "sitimepicker:import",
		"body": ["import { STimePicker } from '@sutekitechid/sicoco-v3-next'"],
		"description": "Import Sicoco TimePicker component"
	}
}
