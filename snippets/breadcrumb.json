{
	"SBreadcrumb Sicoco": {
		"prefix": "sibreadcrumb",
		"body": [
			"<SBreadcrumb>",
			"  <SBreadcrumbItem to=\"$1\">",
			"    $0",
			"  </SBreadcrumbItem>",
			"</SBreadcrumb>"
		],
		"description": "Sicoco Breadcrumb with one item"
	},
	"SBreadcrumb Disabled Sicoco": {
		"prefix": "sibreadcrumb:disabled",
		"body": [
			"<SBreadcrumb>",
			"  <SBreadcrumbItem to=\"$1\" disabled>",
			"    $0",
			"  </SBreadcrumbItem>",
			"</SBreadcrumb>"
		],
		"description": "Sicoco Breadcrumb with disabled item"
	},
	"SBreadcrumb Import Sicoco": {
		"prefix": "sibreadcrumb:import",
		"body": [
			"import { SBreadcrumb, SBreadcrumbItem } from '@sutekitechid/sicoco-v3-next'"
		],
		"description": "Import Sicoco Breadcrumb components"
	}
}
