{
	"Skeleton Basic": {
		"prefix": "siskeleton",
		"body": ["<SSkeleton class=\"$1\" />"],
		"description": "Basic Skeleton component"
	},
	"Skeleton Rounded": {
		"prefix": "siskeleton:rounded",
		"body": ["<SSkeleton class=\"rounded $1\" />"],
		"description": "Skeleton with rounded corners"
	},
	"Skeleton Circle": {
		"prefix": "siskeleton:circle",
		"body": ["<SSkeleton class=\"rounded-full w-10 h-10 $1\" />"],
		"description": "Circular Skeleton"
	},
	"Skeleton Text": {
		"prefix": "siskeleton:text",
		"body": [
			"<div class=\"space-y-2\">",
			"  <SSkeleton class=\"h-4 w-[250px]\" />",
			"  <SSkeleton class=\"h-4 w-[200px]\" />",
			"</div>"
		],
		"description": "Skeleton for text lines"
	},
	"Skeleton Table": {
		"prefix": "siskeleton:table",
		"body": [
			"<table class=\"w-full\">",
			"  <thead>",
			"    <tr>",
			"      <th><SSkeleton class=\"h-4 w-24\" /></th>",
			"      <th><SSkeleton class=\"h-4 w-24\" /></th>",
			"      <th><SSkeleton class=\"h-4 w-24\" /></th>",
			"    </tr>",
			"  </thead>",
			"  <tbody>",
			"    <tr>",
			"      <td><SSkeleton class=\"h-4 w-20\" /></td>",
			"      <td><SSkeleton class=\"h-4 w-20\" /></td>",
			"      <td><SSkeleton class=\"h-4 w-20\" /></td>",
			"    </tr>",
			"    <tr>",
			"      <td><SSkeleton class=\"h-4 w-20\" /></td>",
			"      <td><SSkeleton class=\"h-4 w-20\" /></td>",
			"      <td><SSkeleton class=\"h-4 w-20\" /></td>",
			"    </tr>",
			"  </tbody>",
			"</table>"
		],
		"description": "Skeleton for table"
	},
	"Skeleton Avatar": {
		"prefix": "siskeleton:avatar",
		"body": ["<SSkeleton class=\"w-12 h-12 rounded-full $1\" />"],
		"description": "Skeleton for avatar/profile picture"
	},
	"Skeleton Card": {
		"prefix": "siskeleton:card",
		"body": [
			"<div class=\"w-64 p-4 border rounded\">",
			"  <SSkeleton class=\"h-32 w-full mb-4\" />",
			"  <SSkeleton class=\"h-6 w-3/4 mb-2\" />",
			"  <SSkeleton class=\"h-4 w-1/2\" />",
			"</div>"
		],
		"description": "Skeleton for card (image, title, text)"
	},
	"Skeleton Button": {
		"prefix": "siskeleton:button",
		"body": ["<SSkeleton class=\"h-10 w-32 rounded $1\" />"],
		"description": "Skeleton for button"
	},
	"Skeleton List": {
		"prefix": "siskeleton:list",
		"body": [
			"<ul class=\"space-y-2\">",
			"  <li><SSkeleton class=\"h-4 w-48\" /></li>",
			"  <li><SSkeleton class=\"h-4 w-40\" /></li>",
			"  <li><SSkeleton class=\"h-4 w-44\" /></li>",
			"</ul>"
		],
		"description": "Skeleton for list items"
	}
}
