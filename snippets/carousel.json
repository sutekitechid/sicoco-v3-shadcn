{
	"Carousel Import Sicoco": {
		"prefix": "sicarousel:import",
		"body": [
			"import {",
			"  SCarousel,",
			"  SCarouselContent,",
			"  SCarouselItem,",
			"  SCarouselPagination,",
			"} from '@sutekitechid/sicoco-v3-next'"
		],
		"description": "Carousel component necessary imports"
	},
	"Carousel Basic": {
		"prefix": "sicarousel",
		"body": [
			"<SCarousel :items-per-view=\"1\" :loop=\"false\" :gap=\"16\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in items\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <!-- Pagination below slides -->",
			"  <SCarouselPagination class=\"mt-4 flex justify-center gap-2\" />",
			"</SCarousel>"
		],
		"description": "Basic carousel with pagination below slides"
	},
	"Carousel Multi Items": {
		"prefix": "sicarousel:multi",
		"body": [
			"<SCarousel :items-per-view=\"3\" :gap=\"16\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in items\" :key=\"item.id\" class=\"rounded-lg overflow-hidden\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <SCarouselPagination class=\"mt-4 flex justify-center gap-2\" />",
			"</SCarousel>"
		],
		"description": "Carousel showing 3 items at once"
	},
	"Carousel Overlaid Pagination": {
		"prefix": "sicarousel:overlay",
		"body": [
			"<SCarousel :items-per-view=\"1\" :loop=\"true\" class=\"relative\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in items\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <!-- Overlaid pagination at bottom-center -->",
			"  <SCarouselPagination class=\"absolute bottom-4 inset-x-0 flex justify-center gap-2 z-10\" />",
			"</SCarousel>"
		],
		"description": "Carousel with pagination overlaid at bottom-center"
	},
	"Carousel Side Arrows": {
		"prefix": "sicarousel:sidearrows",
		"body": [
			"<SCarousel :items-per-view=\"1\" :loop=\"false\" class=\"relative px-10\">",
			"  <!-- Prev arrow on the left side -->",
			"  <SCarouselPaginationPrev class=\"absolute left-0 top-1/2 -translate-y-1/2 z-10\" />",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in items\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <!-- Next arrow on the right side -->",
			"  <SCarouselPaginationNext class=\"absolute right-0 top-1/2 -translate-y-1/2 z-10\" />",
			"  <!-- Dots below -->",
			"  <SCarouselPaginationDots class=\"flex justify-center mt-3\" />",
			"</SCarousel>"
		],
		"description": "Carousel with side arrows and dots below — using individual pagination primitives"
	},
	"Carousel Custom Pagination Slot": {
		"prefix": "sicarousel:customnav",
		"body": [
			"<SCarousel :items-per-view=\"1\" :loop=\"false\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in items\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <!-- Fully custom pagination layout via default scoped slot -->",
			"  <SCarouselPagination",
			"    v-slot=\"{ scrollPrev, scrollNext, scrollTo, hasPrev, hasNext, currentSnap, totalSnaps }\"",
			"    class=\"mt-4 flex items-center justify-between\"",
			"  >",
			"    <button :disabled=\"!hasPrev\" @click=\"scrollPrev\">Prev</button>",
			"    <span>{{ currentSnap + 1 }} / {{ totalSnaps }}</span>",
			"    <button :disabled=\"!hasNext\" @click=\"scrollNext\">Next</button>",
			"  </SCarouselPagination>",
			"</SCarousel>"
		],
		"description": "Carousel with fully custom pagination via scoped slot"
	},
	"Carousel Custom Dot Slot": {
		"prefix": "sicarousel:customdot",
		"body": [
			"<SCarousel :items-per-view=\"1\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in items\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <SCarouselPagination class=\"mt-4 flex justify-center gap-2\">",
			"    <!-- Override only the dots, keep default prev/next buttons -->",
			"    <template #dots=\"{ scrollTo, currentSnap, totalSnaps }\">",
			"      <SCarouselPaginationDots>",
			"        <template #dot=\"{ index, isActive, scrollTo: goTo }\">",
			"          <button",
			"            :class=\"['h-1 rounded-full transition-all', isActive ? 'w-6 bg-primary' : 'w-2 bg-neutral-300']\"",
			"            @click=\"goTo\"",
			"          />",
			"        </template>",
			"      </SCarouselPaginationDots>",
			"    </template>",
			"  </SCarouselPagination>",
			"</SCarousel>"
		],
		"description": "Carousel with custom shaped dots"
	}
}
