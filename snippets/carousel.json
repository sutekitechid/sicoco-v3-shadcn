{
	"SCarousel Import Sicoco": {
		"prefix": "sicarousel:import",
		"body": [
			"import {",
			"  SCarousel,",
			"  SCarouselContent,",
			"  SCarouselItem,",
			"  SCarouselPagination,",
			"  SCarouselPaginationPrev,",
			"  SCarouselPaginationNext,",
			"  SCarouselPaginationDots",
			"} from '@sutekitechid/sicoco-v3-next'"
		],
		"description": "Import Sicoco Carousel components"
	},
	"SCarousel Basic Sicoco": {
		"prefix": "sicarousel",
		"body": [
			"<SCarousel :items-per-view=\"1\" :loop=\"false\" :gap=\"16\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in ${1:items}\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <SCarouselPagination class=\"mt-4 flex justify-center gap-2\" />",
			"</SCarousel>"
		],
		"description": "Sicoco Carousel with pagination below slides"
	},
	"SCarousel Multi Items Sicoco": {
		"prefix": "sicarousel:multi",
		"body": [
			"<SCarousel :items-per-view=\"3\" :gap=\"16\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in ${1:items}\" :key=\"item.id\" class=\"rounded-lg overflow-hidden\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <SCarouselPagination class=\"mt-4 flex justify-center gap-2\" />",
			"</SCarousel>"
		],
		"description": "Sicoco Carousel showing 3 items at once"
	},
	"SCarousel Overlaid Pagination Sicoco": {
		"prefix": "sicarousel:overlay",
		"body": [
			"<SCarousel :items-per-view=\"1\" :loop=\"true\" class=\"relative\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in ${1:items}\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <SCarouselPagination class=\"absolute bottom-4 inset-x-0 flex justify-center gap-2 z-10\" />",
			"</SCarousel>"
		],
		"description": "Sicoco Carousel with pagination overlaid at bottom-center"
	},
	"SCarousel Side Arrows Sicoco": {
		"prefix": "sicarousel:sidearrows",
		"body": [
			"<SCarousel :items-per-view=\"1\" :loop=\"false\" class=\"relative px-10\">",
			"  <SCarouselPaginationPrev class=\"absolute left-0 top-1/2 -translate-y-1/2 z-10\" />",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in ${1:items}\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <SCarouselPaginationNext class=\"absolute right-0 top-1/2 -translate-y-1/2 z-10\" />",
			"  <SCarouselPaginationDots class=\"flex justify-center mt-3\" />",
			"</SCarousel>"
		],
		"description": "Sicoco Carousel with side arrows and dots"
	},
	"SCarousel Custom Pagination Slot Sicoco": {
		"prefix": "sicarousel:customnav",
		"body": [
			"<SCarousel :items-per-view=\"1\" :loop=\"false\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in ${1:items}\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <SCarouselPagination",
			"    v-slot=\"{ scrollPrev, scrollNext, hasPrev, hasNext, currentSnap, totalSnaps }\"",
			"    class=\"mt-4 flex items-center justify-between\"",
			"  >",
			"    <button :disabled=\"!hasPrev\" @click=\"scrollPrev\">Prev</button>",
			"    <span>{{ currentSnap + 1 }} / {{ totalSnaps }}</span>",
			"    <button :disabled=\"!hasNext\" @click=\"scrollNext\">Next</button>",
			"  </SCarouselPagination>",
			"</SCarousel>"
		],
		"description": "Sicoco Carousel with fully custom pagination via scoped slot"
	},
	"SCarousel Custom Dot Slot Sicoco": {
		"prefix": "sicarousel:customdot",
		"body": [
			"<SCarousel :items-per-view=\"1\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in ${1:items}\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <SCarouselPagination class=\"mt-4 flex justify-center gap-2\">",
			"    <template #indicator=\"{ scrollTo, currentSnap, totalSnaps }\">",
			"      <SCarouselPaginationDots>",
			"        <template #dot=\"{ index, isActive, scrollTo: goTo }\">",
			"          <button",
			"            :class=\"['h-1 rounded-full transition-all', isActive ? 'w-6 bg-primary' : 'w-2 bg-neutral-300']\"",
			"            @click=\"goTo\"",
			"          />",
			"        </template>",
			"      </SCarouselPaginationDots>",
			"    </template>",
			"  </SCarouselPagination>",
			"</SCarousel>"
		],
		"description": "Sicoco Carousel with custom shaped dots"
	},
	"SCarousel Autoplay Sicoco": {
		"prefix": "sicarousel:autoplay",
		"body": [
			"<SCarousel :autoplay=\"${1:3000}\" :loop=\"true\">",
			"  <SCarouselContent>",
			"    <SCarouselItem v-for=\"item in ${2:items}\" :key=\"item.id\">",
			"      <!-- item content -->",
			"    </SCarouselItem>",
			"  </SCarouselContent>",
			"  <SCarouselPagination class=\"mt-4 flex justify-center gap-2\" />",
			"</SCarousel>"
		],
		"description": "Sicoco Carousel with autoplay"
	}
}
