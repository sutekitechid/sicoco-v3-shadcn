		"prefix": "stextarea",
		"body": [
			"<STextarea",
			"  v-model=\"$1\"",
			"  id=\"$2\"",
			"  placeholder=\"$3\"",
			"  :rows=\"$4\"",
			"  :cols=\"$5\"",
			"/>"
		],
		"description": "Basic usage of STextarea component."
	},
