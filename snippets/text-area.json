{
	"STextarea Basic Sicoco": {
		"prefix": "sitextarea",
		"body": [
			"<STextarea v-model=\"$1\" placeholder=\"$2\" :rows=\"$3\" />"
		],
		"description": "Sicoco Textarea component"
	},
	"STextarea Disabled Sicoco": {
		"prefix": "sitextarea:disabled",
		"body": [
			"<STextarea v-model=\"$1\" placeholder=\"$2\" :rows=\"$3\" disabled />"
		],
		"description": "Sicoco Textarea in disabled state"
	},
	"STextarea Readonly Sicoco": {
		"prefix": "sitextarea:readonly",
		"body": [
			"<STextarea v-model=\"$1\" placeholder=\"$2\" :rows=\"$3\" readonly />"
		],
		"description": "Sicoco Textarea in readonly state"
	},
	"STextarea Maxlength Sicoco": {
		"prefix": "sitextarea:maxlength",
		"body": [
			"<STextarea v-model=\"$1\" placeholder=\"$2\" :rows=\"$3\" :max-length=\"$4\" />"
		],
		"description": "Sicoco Textarea with max-length"
	},
	"STextarea Required Sicoco": {
		"prefix": "sitextarea:required",
		"body": [
			"<STextarea v-model=\"$1\" placeholder=\"$2\" :rows=\"$3\" required>",
			"  <template #required>Cannot be empty</template>",
			"</STextarea>"
		],
		"description": "Sicoco Textarea with required validation"
	},
	"STextarea Minlength Sicoco": {
		"prefix": "sitextarea:minlength",
		"body": [
			"<STextarea v-model=\"$1\" placeholder=\"$2\" :rows=\"$3\" :min-length=\"$4\">",
			"  <template #minLength>Minimum $4 characters</template>",
			"</STextarea>"
		],
		"description": "Sicoco Textarea with min-length validation"
	},
	"STextarea Import Sicoco": {
		"prefix": "sitextarea:import",
		"body": ["import { STextarea } from '@sutekitechid/sicoco-v3-next'"],
		"description": "Import Sicoco Textarea component"
	}
}
