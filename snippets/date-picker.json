{
	"SDatePicker Basic Sicoco": {
		"prefix": "sidatepicker",
		"body": ["<SDatePicker v-model=\"$1\" />"],
		"description": "Sicoco DatePicker component"
	},
	"SDatePicker Range Sicoco": {
		"prefix": "sidatepicker:range",
		"body": [
			"<SDatePicker v-model:start=\"$1\" v-model:end=\"$2\" date-range />"
		],
		"description": "Sicoco DatePicker in date range mode"
	},
	"SDatePicker With Important Dates Sicoco": {
		"prefix": "sidatepicker:important-dates",
		"body": ["<SDatePicker v-model=\"$1\" :important-dates=\"$2\" />"],
		"description": "Sicoco DatePicker with important dates"
	},
	"SDatePicker With Years Range Sicoco": {
		"prefix": "sidatepicker:years-range",
		"body": ["<SDatePicker v-model=\"$1\" :years-range=\"$2\" />"],
		"description": "Sicoco DatePicker with years range"
	},
	"SDatePicker Readonly Sicoco": {
		"prefix": "sidatepicker:readonly",
		"body": ["<SDatePicker v-model=\"$1\" readonly />"],
		"description": "Sicoco DatePicker in readonly mode"
	},
	"SDatePicker Required Sicoco": {
		"prefix": "sidatepicker:required",
		"body": [
			"<SDatePicker v-model=\"$1\" required>",
			"  <template #required>",
			"    <span>$2</span>",
			"  </template>",
			"</SDatePicker>"
		],
		"description": "Sicoco DatePicker with required validation"
	},
	"SDatePicker Disabled Sicoco": {
		"prefix": "sidatepicker:disabled",
		"body": ["<SDatePicker v-model=\"$1\" disabled />"],
		"description": "Sicoco DatePicker in disabled state"
	},
	"SDatePicker Custom Validators Sicoco": {
		"prefix": "sidatepicker:custom-validators",
		"body": [
			"<SDatePicker",
			"  v-model=\"$1\"",
			"  :custom-validators=\"{ customRule: value => value !== null }\"",
			">",
			"  <template #errors=\"{ validation }\">",
			"    <p v-if=\"validation.customRule.$invalid\">$2</p>",
			"  </template>",
			"</SDatePicker>"
		],
		"description": "Sicoco DatePicker with custom validators"
	},
	"SDatePicker Format Date Sicoco": {
		"prefix": "sidatepicker:format-date",
		"body": ["<SDatePicker v-model=\"$1\" :format-date=\"$2\" />"],
		"description": "Sicoco DatePicker with custom date format"
	},
	"SDatePicker Locale Sicoco": {
		"prefix": "sidatepicker:locale",
		"body": ["<SDatePicker v-model=\"$1\" :locale=\"$2\" />"],
		"description": "Sicoco DatePicker with custom locale"
	},
	"SDatePicker Import Sicoco": {
		"prefix": "sidatepicker:import",
		"body": ["import { SDatePicker } from '@sutekitechid/sicoco-v3-next'"],
		"description": "Import Sicoco DatePicker component"
	}
}
