{
	"Tooltip Sicoco": {
		"prefix": "sitooltip",
		"body": [
			"<s-tooltip trigger=\"${1: hover | click | focus}\">",
			"  <template #trigger>",
			"    $2",
			"  </template>",
			"  <s-tooltip-content position=\"${3: top | right | left | bottom}\" variant=\"default\">",
			"    $4",
			"  </s-tooltip-content>",
			"</s-tooltip>"
		],
		"description": "Tooltip with default variant"
	},
