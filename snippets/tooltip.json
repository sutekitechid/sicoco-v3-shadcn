{
	"STooltip Sicoco": {
		"prefix": "sitooltip",
		"body": [
			"<STooltip trigger=\"${1: hover | click | focus}\">",
			"  <template #trigger>",
			"    ${2:trigger content}",
			"  </template>",
			"  <STooltipContent position=\"${3: top | right | left | bottom}\" variant=\"default\">",
			"    ${4:tooltip content}",
			"  </STooltipContent>",
			"</STooltip>"
		],
		"description": "Sicoco Tooltip component with default variant"
	},
