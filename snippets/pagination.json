{
	"SPagination Sicoco": {
		"prefix": "sipagination",
		"body": [
			"<SPagination",
			"  v-model:page=\"${1:page}\"",
			"  v-model:per-page=\"${2:perPage}\"",
			"  :total=\"${3:total}\"",
			"  :default-page=\"${4:1}\"",
			"  :options=\"${5:options}\"",
			"  :per-page-label-text=\"${6:perPageLabelText}\"",
			"  :per-page-item-formatter=\"${7:(perPage) => perPage + ' items'}\"",
			"  :show-per-page-options=\"${8:true}\"",
			"  :show-pagination-input=\"${9:true}\"",
			"/>"
		],
		"description": "Sicoco Pagination component with v-model and props"
	},
	"SPagination Import Sicoco": {
		"prefix": "sipagination:import",
		"body": ["import { SPagination } from '@sutekitechid/sicoco-v3-next'"],
		"description": "Import Sicoco Pagination component"
	}
}
