{
	"SDialog Import Sicoco": {
		"prefix": "sidialog:import",
		"body": [
			"import { SDialog, SDialogContent } from '@sutekitechid/sicoco-v3-next'"
		],
		"description": "Import Sicoco Dialog component"
	},
	"SDialog Sicoco": {
		"prefix": "sidialog",
		"body": [
			"<SDialog v-model:open=\"${1:refOpen}\">",
			"  <SDialogContent>",
			"    ${2:Dialog Content}",
			"  </SDialogContent>",
			"</SDialog>"
		],
		"description": "Sicoco Dialog component with v-model:open"
	},
	"SDialog With Click Outside Close Sicoco": {
		"prefix": "sidialog:click-outside",
		"body": [
			"<SDialog v-model:open=\"${1:refOpen}\" :close-on-click-outside=\"true\">",
			"  <SDialogContent>",
			"    ${2:Dialog Content}",
			"  </SDialogContent>",
			"</SDialog>"
		],
		"description": "Sicoco Dialog that closes on overlay click"
	}
}
