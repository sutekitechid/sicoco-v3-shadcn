{
	"SButton Basic Sicoco": {
		"prefix": "sibutton",
		"body": ["<SButton>$1</SButton>"],
		"description": "Sicoco Button component"
	},
	"SButton Primary Sicoco": {
		"prefix": "sibutton:primary",
		"body": ["<SButton variant=\"primary\">$1</SButton>"],
		"description": "Sicoco Button with primary variant"
	},
