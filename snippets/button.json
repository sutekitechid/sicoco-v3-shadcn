		"body": ["<SButton variant=\"success\">$1</SButton>"],
		"description": "Sicoco Button with success variant"
	},
	"SButton Warning Sicoco": {
		"prefix": "sibutton:warning",
		"body": ["<SButton variant=\"warning\">$1</SButton>"],
		"description": "Sicoco Button with warning variant"
	},
