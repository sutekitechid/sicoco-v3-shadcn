{
	"STabs Sicoco": {
		"prefix": "sitabs",
		"body": [
			"<STabs",
			"  v-model=\"${1:tabConfig.value}\"",
			"  :default-value=\"${2:tabConfig.defaultValue}\"",
			"  variant=\"${3: default | boxes}\"",
			"  orientation=\"${4: horizontal | vertical}\"",
			">",
			"  <STabsList>",
			"    <STabsTrigger",
			"      v-for=\"(trigger, idx) in ${5:tabConfig.triggers}\"",
			"      :key=\"idx\"",
			"      :value=\"trigger.value\"",
			"      :badge-count=\"trigger.badgeCount\"",
			"      :disabled=\"trigger.disabled\"",
			"    >",
			"      {{ trigger.label }}",
			"    </STabsTrigger>",
			"  </STabsList>",
			"  <STabsContent",
			"    v-for=\"(content, idx) in ${6:tabConfig.contents}\"",
			"    :key=\"idx\"",
			"    :value=\"content.value\"",
			"  >",
			"  </STabsContent>",
			"</STabs>"
		],
		"description": "Sicoco Tabs component with STabsList, STabsTrigger, STabsContent"
	},
	"Import Tabs Sicoco": {
		"prefix": "sitabs:import",
		"body": [
			"import { STabs, STabsList, STabsTrigger, STabsContent } from '@sutekitechid/sicoco-v3-next';"
		],
		"description": "Import Sicoco Tabs components"
	}
}
