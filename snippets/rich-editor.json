{
	"SRichTextEditor Sicoco": {
		"prefix": "sirichtexteditor",
		"body": [
			"<SRichTextEditor v-model=\"${1:content}\" placeholder=\"${2:Please enter content}\" />"
		],
		"description": "Sicoco RichTextEditor component"
	},
	"SRichTextEditor Required Sicoco": {
		"prefix": "sirichtexteditor:required",
		"body": [
			"<SRichTextEditor v-model=\"${1:content}\" placeholder=\"${2:Please enter content}\" required>",
			"  <template #required>${3:Cannot be empty}</template>",
			"</SRichTextEditor>"
		],
		"description": "Sicoco RichTextEditor with required validation"
	},
	"SRichTextEditor Maxlength Sicoco": {
		"prefix": "sirichtexteditor:maxlength",
		"body": [
			"<SRichTextEditor v-model=\"${1:content}\" placeholder=\"${2:Please enter content}\" :maxlength=\"${3:100}\">",
			"  <template #maxlength>${4:Max: 100}</template>",
			"</SRichTextEditor>"
		],
		"description": "Sicoco RichTextEditor with maxlength validation"
	},
	"SRichTextEditor Attachment Toolbar Sicoco": {
		"prefix": "sirichtexteditor:attachment",
		"body": [
			"<SRichTextEditor v-model=\"${1:content}\" placeholder=\"${2:Please enter content}\" attachments-toolbar :image-upload-handler=\"${3:imageUploader}\" :video-upload-handler=\"${4:videoUploader}\" :attachment-upload-handler=\"${5:attachmentUploader}\" />"
		],
		"description": "Sicoco RichTextEditor with attachment toolbar"
	},
	"SRichTextEditor Full Sicoco": {
		"prefix": "sirichtexteditor:full",
		"body": [
			"<SRichTextEditor v-model=\"${1:content}\" placeholder=\"${2:Please enter content}\" :maxlength=\"${3:100}\" required attachments-toolbar :image-upload-handler=\"${4:imageUploader}\" :video-upload-handler=\"${5:videoUploader}\" :attachment-upload-handler=\"${6:attachmentUploader}\">",
			"  <template #maxlength>${7:Max: 100}</template>",
			"  <template #required>${8:Cannot be empty}</template>",
			"</SRichTextEditor>"
		],
		"description": "Sicoco RichTextEditor with maxlength, required, and attachment toolbar"
	},
	"SRichTextEditor Custom Toolbar Sicoco": {
		"prefix": "sirichtexteditor:custom-toolbar",
		"body": [
			"<SRichTextEditor v-model=\"${1:content}\" placeholder=\"${2:Please enter content}\" :toolbar-items=\"${3:['undo', 'redo', 'bold', 'italic', 'underline', 'link']}\" />"
		],
		"description": "Sicoco RichTextEditor with custom toolbar items (whitelist). Available items: undo, redo, header, alignment, bold, italic, underline, strike, subscript, superscript, clean, list-ordered, list-bullet, link, image, video, attachment, table, blockquote, code-block"
	},
	"SRichTextEditor Import Sicoco": {
		"prefix": "sirichtexteditor:import",
		"body": ["import { SRichTextEditor } from '@sutekitechid/sicoco-v3-next'"],
		"description": "Import Sicoco RichTextEditor component"
	}
}
