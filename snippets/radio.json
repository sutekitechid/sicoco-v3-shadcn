{
	"Radio Sicoco": {
		"prefix": "siradio",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem value=\"${2:option1}\">",
			"    $3",
			"  </SRadioGroupItem>",
			"  <SRadioGroupItem value=\"${4:option2}\">",
			"    $5",
			"  </SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Default Sicoco Radio and RadioGroup with two selectable options"
	},
	"Radio Primary Sicoco": {
		"prefix": "siradio:primary",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem value=\"${2:option1}\" variant=\"primary\">",
			"    $3",
			"  </SRadioGroupItem>",
			"  <SRadioGroupItem value=\"${4:option2}\" variant=\"primary\">",
			"    $5",
			"  </SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with primary variant items"
	},
	"Radio Danger Sicoco": {
		"prefix": "siradio:danger",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem value=\"${2:option1}\" variant=\"danger\">",
			"    $3",
			"  </SRadioGroupItem>",
			"  <SRadioGroupItem value=\"${4:option2}\" variant=\"danger\">",
			"    $5",
			"  </SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with danger variant items"
	},
	"Radio Warning Sicoco": {
		"prefix": "siradio:warning",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem value=\"${2:option1}\" variant=\"warning\">",
			"    $3",
			"  </SRadioGroupItem>",
			"  <SRadioGroupItem value=\"${4:option2}\" variant=\"warning\">",
			"    $5",
			"  </SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with warning variant items"
	},
	"Radio Success Sicoco": {
		"prefix": "siradio:success",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem value=\"${2:option1}\" variant=\"success\">",
			"    $3",
			"  </SRadioGroupItem>",
			"  <SRadioGroupItem value=\"${4:option2}\" variant=\"success\">",
			"    $5",
			"  </SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with success variant items"
	},
	"Radio Required Sicoco": {
		"prefix": "siradio:required",
		"body": [
			"<SRadioGroup required v-model=\"$1\">",
			"  <SRadioGroupItem value=\"$2\" variant=\"$3\">$4</SRadioGroupItem>",
			"  <template #required>",
			"    <${5:p}>$0</$5>",
			"  </template>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with required validation message"
	},
	"Radio Disabled Sicoco": {
		"prefix": "siradio:disabled",
		"body": [
			"<SRadioGroup required v-model=\"$1\">",
			"  <SRadioGroupItem value=\"$2\" variant=\"$3\" disabled>$4</SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with disabled item"
	},
	"Radio Custom Validator Sicoco": {
		"prefix": "siradio:validator",
		"body": [
			"<SRadioGroup",
			"  :custom-validators=\"$1\"",
			"  v-model=\"$2\"",
			">",
			"  <SRadioGroupItem value=\"$3\" variant=\"$4\">$5</SRadioGroupItem>",
			"  <SRadioGroupItem value=\"$6\" variant=\"$7\">$8</SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with custom validator"
	},
	"Import Radio Sicoco": {
		"prefix": "siradio:import",
		"body": [
			"import { SRadioGroupItem, SRadioGroup } from '@sutekitechid/sicoco-v3-next'"
		],
		"description": "Import RadioGroup and RadioGroupItem from Sicoco library"
	}
}
