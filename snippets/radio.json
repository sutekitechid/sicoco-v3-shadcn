{
	"SRadioGroup Sicoco": {
		"prefix": "siradio",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem :value=\"${2:option1}\">$3</SRadioGroupItem>",
			"  <SRadioGroupItem :value=\"${4:option2}\">$5</SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with two selectable options"
	},
	"SRadioGroup Primary Sicoco": {
		"prefix": "siradio:primary",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem :value=\"${2:option1}\" variant=\"primary\">$3</SRadioGroupItem>",
			"  <SRadioGroupItem :value=\"${4:option2}\" variant=\"primary\">$5</SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with primary variant items"
	},
	"SRadioGroup Danger Sicoco": {
		"prefix": "siradio:danger",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem :value=\"${2:option1}\" variant=\"danger\">$3</SRadioGroupItem>",
			"  <SRadioGroupItem :value=\"${4:option2}\" variant=\"danger\">$5</SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with danger variant items"
	},
	"SRadioGroup Warning Sicoco": {
		"prefix": "siradio:warning",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem :value=\"${2:option1}\" variant=\"warning\">$3</SRadioGroupItem>",
			"  <SRadioGroupItem :value=\"${4:option2}\" variant=\"warning\">$5</SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with warning variant items"
	},
	"SRadioGroup Success Sicoco": {
		"prefix": "siradio:success",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem :value=\"${2:option1}\" variant=\"success\">$3</SRadioGroupItem>",
			"  <SRadioGroupItem :value=\"${4:option2}\" variant=\"success\">$5</SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with success variant items"
	},
	"SRadioGroup Required Sicoco": {
		"prefix": "siradio:required",
		"body": [
			"<SRadioGroup required v-model=\"$1\">",
			"  <SRadioGroupItem :value=\"$2\" variant=\"$3\">$4</SRadioGroupItem>",
			"  <template #required>",
			"    <${5:p}>$0</${5:p}>",
			"  </template>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with required validation slot"
	},
	"SRadioGroup Disabled Sicoco": {
		"prefix": "siradio:disabled",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem :value=\"$2\" variant=\"$3\" disabled>$4</SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with disabled item"
	},
	"SRadioGroup Custom Validator Sicoco": {
		"prefix": "siradio:validator",
		"body": [
			"<SRadioGroup :custom-validators=\"$1\" v-model=\"$2\">",
			"  <SRadioGroupItem :value=\"$3\" variant=\"$4\">$5</SRadioGroupItem>",
			"  <SRadioGroupItem :value=\"$6\" variant=\"$7\">$8</SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with custom validator"
	},
	"SRadioGroup With Label Component Sicoco": {
		"prefix": "siradio:label",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem :value=\"${2:option1}\">",
			"    <SRadioGroupItemLabel>$3</SRadioGroupItemLabel>",
			"  </SRadioGroupItem>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with explicit SRadioGroupItemLabel"
	},
	"SRadioGroup Error Message Sicoco": {
		"prefix": "siradio:error",
		"body": [
			"<SRadioGroup v-model=\"$1\">",
			"  <SRadioGroupItem :value=\"${2:option1}\">$3</SRadioGroupItem>",
			"  <template #errors=\"{ validation }\">",
			"    <SRadioGroupErrorMessage :validation=\"validation\" />",
			"  </template>",
			"</SRadioGroup>"
		],
		"description": "Sicoco Radio with custom error message component"
	},
	"SRadioGroup Import Sicoco": {
		"prefix": "siradio:import",
		"body": [
			"import {",
			"  SRadioGroup,",
			"  SRadioGroupItem,",
			"  SRadioGroupItemLabel,",
			"  SRadioGroupErrorMessage",
			"} from '@sutekitechid/sicoco-v3-next'"
		],
		"description": "Import Sicoco Radio components"
	}
}
