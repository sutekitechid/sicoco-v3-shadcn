{
  "Button Sicoco": {
    "prefix": "sbutton:disabled",
    "body": [
      "<SButton @click=\"$1\">",
      "  $2 Button Text",
      "</SButton>"
    ],
    "description": "Insert a SButton component with click handler"
  },
  "Card Sicoco": {
    "prefix": "scard",
    "body": [
      "<SCard>",
      "  <SCardHeader>",
      "    $1 // slot content here",
      "  </SCardHeader>",
      "  <SCardContent>",
      "    $2 // card content here",
      "  </SCardContent>",
      "</SCard>"
    ],
    "description": "Insert a SCard component structure with header and content slots"
  },
  "Form Input Sicoco": {
    "prefix": "sforminput",
    "body": [
      "<SFormInput",
      "  autocomplete=\"${1:on}\"",
      "  novalidate",
      "  @submit=\"${2}\"",
      ">",
      "${3}",
      "</SFormInput>"
    ],
    "description": "A form input component that provides validation functionality for child input components. It supports autocomplete, prevents default form submission, and emits a submit event when all inputs are valid. Includes methods to reset inputs and manage validation functions for child components."
  }
}