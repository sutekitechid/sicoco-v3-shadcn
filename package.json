{
	"name": "@sutekitechid/sicoco-v3-next",
	"version": "4.0.0-alpha.24",
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"prepublishOnly": "npm run build",
		"test:watch": "vitest",
		"cypress:run": "cypress run --browser electron",
		"test:e2e": "npm run build:app:e2e && start-server-and-test start http://localhost:5173 cypress:run",
		"test": "vitest run",
		"postbuild": "node ./scripts/merge-snippets.js",
		"lint": "eslint . --ext .js,.ts,.vue",
		"lint:fix": "eslint . --ext .js,.ts,.vue --fix",
		"build:app": "vite build --config src/vite.config.ts",
		"build:app:e2e": "vite build --config src/vite.config.ts --mode e2e",
		"dev:app": "vite --config src/vite.config.ts",
		"start": "npx serve -l 5173 dist-app --single",
		"prepare": "husky install"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/vue-table": "^8.20.5",
		"@tanstack/vue-virtual": "^3.13.19",
		"@vuelidate/core": "^2.0.3",
		"@vuelidate/validators": "^2.0.4",
		"@vueuse/core": "^14.2.1",
		"@windmillcode/quill-emoji": "^2.0.3000",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"embla-carousel": "^8.6.0",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-vue": "^8.6.0",
		"quill": "^2.0.3",
		"quill-better-table": "^1.2.10",
		"quill-magic-url": "^4.2.0",
		"quill-table-ui": "^1.0.7",
		"reka-ui": "^2.10.1",
		"sanitize-html": "^2.17.1",
		"tailwind-merge": "^2.5.5",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.0",
		"@types/chroma-js": "^3.1.2",
		"@types/node": "^22.10.1",
		"@typescript-eslint/eslint-plugin": "^8.35.0",
		"@typescript-eslint/parser": "^8.35.0",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vue/eslint-config-typescript": "^14.5.1",
		"@vue/test-utils": "^2.4.6",
		"chroma-js": "^3.1.2",
		"cypress": "^14.3.3",
		"eslint": "^9.30.0",
		"eslint-plugin-vue": "^10.2.0",
		"glob": "^11.1.0",
		"happy-dom": "^20.0.2",
		"husky": "^9.1.7",
		"imagekit": "^6.0.0",
		"lint-staged": "^16.2.7",
		"serve": "^14.2.5",
		"start-server-and-test": "^2.0.11",
		"typescript": "~5.6.2",
		"unplugin-vue-define-options": "^1.5.2",
		"vite": "^6.4.2",
		"vite-dts": "^1.0.4",
		"vite-plugin-dts": "^4.4.0",
		"vite-plugin-eslint": "^1.8.1",
		"vite-plugin-static-copy": "^2.3.2",
		"vitest": "^3.0.8",
		"vue": "^3.5.18",
